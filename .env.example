# Database
RAVIKA_DB_PATH=./data/ravika.sqlite

# Session
RAVIKA_SESSION_COOKIE_SECURE=false

# Bootstrap produksi
RAVIKA_BOOTSTRAP_OWNER_NAME=Pemilik
RAVIKA_BOOTSTRAP_OWNER_EMAIL=owner@example.com
RAVIKA_BOOTSTRAP_OWNER_PASSWORD=password1234

# Bisnis
RAVIKA_BUSINESS_NAME=RAVIKA
RAVIKA_BUSINESS_CODE=RVK
RAVIKA_BUSINESS_ADDRESS=Jakarta Selatan
RAVIKA_BUSINESS_PHONE=021-000000

# QR token encryption (base64 32 bytes, required in production)
RAVIKA_QR_TOKEN_KEY=

# Backup harian. Set none untuk mematikan jadwal.
RAVIKA_BACKUP_SCHEDULE=none
RAVIKA_BACKUP_TIME=02:00
RAVIKA_BACKUP_RETENTION=7

# Test-only: keep development seed when running a production build for E2E
# RAVIKA_SEED_MODE=development
